# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=dein_discord_token_hier

# ── Snipe-Bot (Vinted-Suche) ──────────────────────────────────────────────────
# Pfad zur JSON-Datei mit deinen gespeicherten !add-Suchen (bei Railway auf ein
# Volume zeigen lassen, z.B. /data/monitor_urls.json — sonst gehen alle
# !add-Suchen bei jedem Redeploy verloren, siehe SETUP.md)
MONITOR_URLS_FILE=monitor_urls.json
# Optional: Pfad zur Proxy-Liste, falls genutzt (gleiche Regel wie oben)
PROXIES_FILE=proxies.txt

# ── Webshare Rotating Proxy ───────────────────────────────────────────────────
# Zu finden unter: https://proxy.webshare.io/proxy/list → "Rotating Proxy"
WEBSHARE_USER=dein_webshare_benutzername
WEBSHARE_PASS=dein_webshare_passwort

# ── Listing-Bot ───────────────────────────────────────────────────────────────
# Discord-Channel-Name, in den neue Inserate gepostet werden (ohne #)
LISTING_CHANNEL_NAME=verkauf

# Optional, für automatisches Erstellen von Vinted-Inseraten (experimentell,
# siehe SETUP.md). Ohne diesen Wert postet !inserat nur in Discord.
# So bekommst du den Cookie-String:
#   1. In vinted.de im Browser einloggen
#   2. DevTools öffnen (F12) → Tab "Network" → Seite neu laden
#   3. Einen beliebigen Request an vinted.de anklicken → Request Headers → "Cookie"
#   4. Den kompletten Cookie-String hierher kopieren
VINTED_SESSION_COOKIE=

# ── Buchhaltungs-Bot ──────────────────────────────────────────────────────────
# Pfad zur SQLite-Datenbank (bei Railway auf ein Volume zeigen lassen, z.B.
# /data/buchhaltung.db — sonst geht der Verlauf bei jedem Redeploy verloren,
# siehe SETUP.md)
BUCHHALTUNG_DB=buchhaltung.db

# ── KI (Listing-Vorschlag, Coach) – kostenlos ────────────────────────────────
# Ohne diesen Key musst du Titel/Marke/Beschreibung bei !inserat manuell eintippen,
# und !coach funktioniert nicht.
# Kostenloser Key (kein Kreditkarte nötig): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── Verkauft-Check ────────────────────────────────────────────────────────────
# Wie oft (Minuten) automatisch geprüft wird, ob mit !vinted-link verknüpfte
# Artikel noch auf Vinted aktiv sind.
VERKAUFT_CHECK_MINUTES=60
# Kanal für die automatischen Alarme (ohne #). Standard: gleicher Kanal wie Listings.
VERKAUFT_CHECK_CHANNEL=verkauf

# ── Try-On (experimentell) ────────────────────────────────────────────────────
# yisol/IDM-VTON = originale, zuverlässigste IDM-VTON-Space. Bei Ausfall
# austauschbar gegen eine andere Space mit "api_name='tryon'".
TRYON_SPACE=yisol/IDM-VTON
TRYON_MODELS_DIR=assets/models

# ── Willkommensnachricht ──────────────────────────────────────────────────────
# Teilstring des Kanalnamens für die automatische Begrüßung neuer Mitglieder.
WELCOME_CHANNEL_NAME=chat-all
# Exakter Name der VIP-Rolle in deinem Server – steuert ob jemand die volle
# oder die abgespeckte (nur Snipe-Bot) Willkommensnachricht bekommt.
VIP_ROLE_NAME=VIP

# ── Trend-Radar ───────────────────────────────────────────────────────────────
# Kanal (ohne #) für die automatischen Trend-Posts.
TRENDS_CHANNEL_NAME=trend-radar
# Uhrzeit (Stunde, Europe/Berlin) für das tägliche Update. Standard: 8 (morgens).
TREND_DAILY_HOUR=8
# Uhrzeit (Stunde, Europe/Berlin) für den Recap, läuft nur sonntags. Standard: 18 (abends).
TREND_WEEKLY_HOUR=18
# Wie BUCHHALTUNG_DB: bei Railway auf's Volume zeigen lassen, z.B. /data/trends.db
TRENDS_DB=trends.db
